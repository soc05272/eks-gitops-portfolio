# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl 은 커밋한다 (프로바이더 버전 고정 = 재현성)
crash.log

# plan 파일에는 sensitive 변수가 평문으로 들어간다
tfplan
*.tfplan

# 백엔드 버킷명(계정 고유 값) — example만 커밋한다
backend.hcl
!backend.hcl.example

# 자격증명 — 절대 커밋 금지
*.pem
*.csv
.env

# Python
__pycache__/
*.pyc
.venv/

# OS/IDE
.DS_Store
.vscode/

# 모니터링 — Slack Webhook 등 비밀값 포함 파일
monitoring/values-secret.yaml
.slack_webhook

