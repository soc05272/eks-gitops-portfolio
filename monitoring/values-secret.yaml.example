# Alertmanager → Slack 라우팅 설정의 example.
# 실제 파일(values-secret.yaml)은 Slack Webhook을 포함하므로 gitignore 대상이고, 설치 시 values.yaml과 함께 -f로 전달한다:
#   cp monitoring/values-secret.yaml.example monitoring/values-secret.yaml   # 그리고 <SLACK_WEBHOOK_URL> 교체
#   helm install monitoring prometheus-community/kube-prometheus-stack -n monitoring --create-namespace \
#     -f monitoring/values.yaml -f monitoring/values-secret.yaml
# 커스텀 규칙(alert-rules.yaml)과 스택 기본 규칙이 같은 route를 타므로 한 채널로 유입된다.
alertmanager:
  config:
    global:
      resolve_timeout: 5m
    route:
      receiver: slack
      group_by: ["alertname", "namespace"]
      group_wait: 30s
      repeat_interval: 4h
      routes:
        - receiver: "null" # Watchdog은 "살아있음" 신호라 알람으로 보내지 않음
          matchers:
            - alertname = "Watchdog"
    receivers:
      - name: "null"
      - name: slack
        slack_configs:
          - api_url: "<SLACK_WEBHOOK_URL>" # Slack Incoming Webhook URL
            send_resolved: true # 복구(RESOLVED) 통보까지 전송
